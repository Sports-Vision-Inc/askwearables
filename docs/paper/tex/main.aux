\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces AskWearables{} raised accuracy for the models that were weak with raw context; no model was significantly less accurate with it. Accuracy in \% with Wilson 95\% intervals; $p$ is the exact McNemar test on paired tasks, with the number of tasks only \textsf  {C}{} answered correctly and only the other condition answered correctly in parentheses. Superscript $n$ marks cells with fewer than 100{} scored runs. 5{} of the 5{} significant differences against \textsf  {A}{}, and 4{} of the 4{} against \textsf  {B}{}, remain significant after Holm correction over all 18{} tests.}}{13}{table.caption.36}\protected@file@percent }
\newlabel{tab:accuracy}{{4}{13}{\sys {} raised accuracy for the models that were weak with raw context; no model was significantly less accurate with it. Accuracy in \% with Wilson 95\% intervals; $p$ is the exact McNemar test on paired tasks, with the number of tasks only \CC {} answered correctly and only the other condition answered correctly in parentheses. Superscript $n$ marks cells with fewer than \nTasks {} scored runs. \nHolmCA {} of the \nSigCA {} significant differences against \CA {}, and \nHolmCB {} of the \nSigCB {} against \CB {}, remain significant after Holm correction over all \nTestsHolm {} tests}{table.caption.36}{}}
\newlabel{tab:accuracy@cref}{{[table][4][]4}{[1][13][]13}{}{}{}}
