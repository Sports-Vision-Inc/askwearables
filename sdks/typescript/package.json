{
  "name": "@askwearables/sdk",
  "version": "1.0.0",
  "description": "TypeScript client for the AskWearables API: signed developer requests, typed packets, retries on 429.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "generate": "tsx codegen/run.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --root ../.. sdks/typescript"
  }
}
