{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@askwearables/core": ["./vendor/core/src/index.ts"],
      "@askwearables/importers": ["./vendor/importers/src/index.ts"]
    }
  },
  "include": ["src"]
}
