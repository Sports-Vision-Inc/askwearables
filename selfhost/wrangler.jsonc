// AskWearables, self-host edition: one Worker for one owner. See README.md.
// Resource names are defaults: the Deploy to Cloudflare button creates the D1 database, KV namespace and
// Durable Object in your account and writes their ids into your copy of this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "askwearables-selfhost",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "upload_source_maps": true,
  // Served on <name>.<your-subdomain>.workers.dev. No custom domains or routes.
  "workers_dev": true,
  "preview_urls": false,
  // The shared packages are vendored (see vendor/MANIFEST.json); these aliases resolve their package names.
  "alias": {
    "@askwearables/core": "./vendor/core/src/index.ts",
    "@askwearables/importers": "./vendor/importers/src/index.ts"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "askwearables-selfhost",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_VAULT",
        "class_name": "UserVault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserVault"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "PLANNER_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "PLANNER_FALLBACK_MODEL": "@cf/openai/gpt-oss-120b"
  }
}
