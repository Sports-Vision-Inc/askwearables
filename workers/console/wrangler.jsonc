{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "askwearables-console",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "app.askwearables.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "services": [
    {
      "binding": "GATE",
      "service": "askwearables-gate"
    },
    {
      "binding": "PLANNER",
      "service": "askwearables-planner"
    }
  ],
  "vars": {
    "AUTH_URL": "https://auth.askwearables.app",
    "CONSOLE_ORIGIN": "https://app.askwearables.app"
  }
}