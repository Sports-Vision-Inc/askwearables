{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "askwearables-planner",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "PLANNER_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "PLANNER_FALLBACK_MODEL": "@cf/openai/gpt-oss-120b"
  }
}